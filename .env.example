APP_NAME=VakeVahti
APP_ENV=development
TIMEZONE=Europe/Helsinki
STM_URL=https://stm.fi/vuoden-2026-valtionavustushaut
HAEAVUSTUKSIA_URL=https://www.haeavustuksia.fi/fi/?isAdditionalSearchOpen=true
EURA_URL=https://eura2021.fi/hakuilmoitukset
SITRA_URL=https://asiointi.sitra.fi/
ACADEMY_URL=https://www.aka.fi/tutkimusrahoitus/hae-rahoitusta/haut/
HTTP_TIMEOUT_SECONDS=30
USER_AGENT=VakeVahti/0.1 (+replace-with-maintainer-contact)
DATABASE_URL=postgresql+asyncpg://vakevahti:vakevahti@127.0.0.1:55432/vakevahti
TEST_DATABASE_URL=postgresql+asyncpg://vakevahti:vakevahti@127.0.0.1:55432/vakevahti_test
ENABLED_SOURCES=STM,HAEAVUSTUKSIA,EURA,SITRA,ACADEMY
SCAN_INTERVAL_MINUTES=60
SCAN_RUN_ON_STARTUP=true

# Identity boundary: development is allowed only outside production.
IDENTITY_MODE=development
# In production set IDENTITY_MODE=gateway and inject this secret from approved secret storage.
IDENTITY_GATEWAY_SHARED_SECRET=
IDENTITY_GATEWAY_MAX_AGE_SECONDS=300
